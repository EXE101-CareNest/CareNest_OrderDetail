{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseSettings": {
    "Ip": "${DB_HOST}",
    "Port": "${DB_PORT}",
    "User": "${DB_USER}",
    "Password": "${DB_PASSWORD}",
    "Database": "${DB_NAME}"
  },
  "ProductDetailApi": {
    "BaseUrl": "${PRODUCT_DETAIL_API_URL}"
  },
  "ShopApi": {
    "BaseUrl": "${SHOP_API_URL}"
  },
  "Swagger": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}

