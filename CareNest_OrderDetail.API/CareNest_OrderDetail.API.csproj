		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>bin\Debug\net8.0\CareNest_OrderDetail.API.xml</DocumentationFile>
		<UserSecretsId>3eb63e61-7b8f-4e52-8086-31bdf1422af6</UserSecretsId>
